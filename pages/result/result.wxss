.container {
  background: #F4F7FF;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  padding: 240rpx 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #E0E4EA;
  border-top-color: #6A5AE0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: 20rpx;
  color: #8D8FA3;
  font-size: 26rpx;
}

/* ===== 主要内容容器（撑满剩余空间） ===== */
.content-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ===== 顶部背景与机器人 ===== */
.header-bg {
  height: 360rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #6A5AE0 0%, #D83AB3 100%);
  position: relative;
  border-radius: 0 0 50rpx 50rpx;
  overflow: hidden;
}
.robot-icon {
  position: absolute;
  left: 50%;
  top: 60rpx;
  width: 260rpx;
  height: 260rpx;
  margin-left: -130rpx;
  transform: scale(2.8);
  transform-origin: center center;
}

/* ===== 分数展示卡片（玻璃拟态） ===== */
.score-card {
  margin: -160rpx 40rpx 0;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 40rpx;
  padding: 60rpx 0;
  text-align: center;
  box-shadow: 0 20rpx 40rpx rgba(106, 90, 224, 0.12);
  position: relative;
  z-index: 10;
}
.score-num {
  font-size: 100rpx;
  font-weight: 800;
  color: #1A1C3D;
  line-height: 1;
}
.score-num .unit {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1C3D;
}
.score-label {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #6A5AE0;
}
.score-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9CA0B4;
}
.disclaimer {
  margin: 16rpx 40rpx 0;
  padding: 0 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9ca0b4;
  text-align: center;
}
.info-icon {
  font-size: 24rpx;
  vertical-align: middle;
  margin-left: 4rpx;
}

/* ===== 刻度进度条 ===== */
.scale-container {
  margin: 28rpx 40rpx 0;
  flex-shrink: 0;
}
.scale-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: linear-gradient(to right, #2ECC71, #4CD964, #FFDB5C, #FF9F43, #FF4D4D);
  position: relative;
}
.indicator {
  position: absolute;
  top: -14rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  margin-left: -20rpx;
  z-index: 2;
}
.indicator::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6A5AE0, #D83AB3);
  transform: translate(-50%, -50%);
}
.scale-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #9CA0B4;
}
.scale-labels .active {
  color: #6A5AE0;
  font-weight: 700;
  font-size: 24rpx;
}

/* ===== 返回按钮 ===== */
.back-btn {
  position: fixed;
  left: 16rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
  z-index: 50;
}
.back-btn:active {
  background: rgba(255, 255, 255, 0.35);
}

/* ===== v2.0 语义一致性卡片 ===== */
.consistency-section {
  margin: 20rpx 32rpx 0;
  flex-shrink: 0;
}
.consistency-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.consistency-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(106, 90, 224, 0.06);
}
.consistency-item.warn {
  background: #FFFBEB;
  border: 2rpx solid #FDE68A;
}
.consistency-label {
  font-size: 22rpx;
  color: #9CA0B4;
}
.consistency-val {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A1C3D;
  margin-top: 10rpx;
}
.consistency-item.warn .consistency-val {
  color: #F59E0B;
}

/* ===== AI痕迹分析列表空状态 ===== */
.empty-issues {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}
.empty-issues-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #E8F5E9;
  color: #4CAF50;
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  line-height: 80rpx;
}
.empty-issues-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #9CA0B4;
}

/* ===== 底部操作按钮（固定窗口底部） ===== */
.btn-area {
  position: fixed;
  bottom: 90rpx;
  left: 0;
  right: 0;
  z-index: 100;
  background: #F4F7FF;
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}
.action-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
  border: none;
  flex: 1;
}
.action-btn-primary {
  background: linear-gradient(90deg, #6A5AE0 0%, #D83AB3 100%);
  color: #FFFFFF;
  box-shadow: 0 10rpx 30rpx rgba(106, 90, 224, 0.3);
}
.action-btn-primary:active {
  opacity: 0.9;
  transform: translateY(2rpx);
}
.action-btn-secondary {
  background: #FFFFFF;
  color: #333333;
  border: 2rpx solid #D9DCE5;
}
.action-btn-secondary:active {
  background: #F5F6F8;
}

/* ===== AI痕迹分析列表 ===== */
.analysis-section {
  margin: 10px 32rpx 100rpx;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(39, 52, 125, 0.08);
  padding: 28rpx 28rpx 20rpx;
}
.analysis-section.empty {
  margin-bottom: 250rpx;
}

.analysis-scroll-wrap {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.analysis-scroll {
  height: 100%;
  overflow-y: scroll;
  padding-bottom: 20rpx;
}
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1C3D;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}
.section-title .count {
  font-size: 24rpx;
  font-weight: 400;
  color: #9CA0B4;
  margin-left: 12rpx;
  line-height: 8rpx;
}

.issue-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  height: 112rpx;
  box-sizing: border-box;
  border-left: 6rpx solid transparent;
}
.issue-item:last-child {
  margin-bottom: 0;
}

.issue-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.issue-num {
  font-size: 24rpx;
  font-weight: 800;
  color: #1A1C3D;
}
.issue-content {
  flex: 1;
  min-width: 0;
}
.issue-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1C3D;
}
.issue-detail {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9CA0B4;
  line-height: 1.35;
}

.issue-tag {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-align: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.issue-tag.high {
  background: #FFF0ED;
  color: #EF4444;
}
.issue-tag.medium {
  background: #FFFBEB;
  color: #F59E0B;
}
.issue-tag.low {
  background: #F0FDF4;
  color: #22C55E;
}

/* ===== 空状态 ===== */
.empty-state {
  padding: 240rpx 32rpx 0;
  text-align: center;
}
.empty-title {
  display: block;
  color: #1A1C3D;
  font-size: 30rpx;
  font-weight: 800;
}
.empty-desc {
  display: block;
  margin-top: 14rpx;
  color: #9CA0B4;
  font-size: 24rpx;
}

/* ===== 底部安全区 ===== */
.bottom-spacer {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
