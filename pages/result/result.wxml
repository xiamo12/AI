<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 主要内容 -->
  <view wx:elif="{{analysis}}" class="content-wrap">
    <!-- 返回按钮 -->
    <view class="back-btn" style="top: calc({{statusBarHeight}}px + 12px);" bindtap="goBack">‹</view>

    <!-- 顶部背景与机器人 -->
    <view class="header-bg">
      <image class="robot-icon" src="/assets/home/robot.png" mode="widthFix" />
    </view>

    <!-- 分数展示卡片 -->
    <view class="score-card">
      <view class="score-num">{{analysis.score}}<text class="unit">%</text></view>
      <view class="score-label">{{riskLabel}}</view>
      <view class="score-desc">AI 痕迹参考指数 <text class="info-icon">ⓘ</text></view>
      <view class="disclaimer">本结果由本地规则生成，仅供写作辅助参考，不构成权威鉴定。</view>
    </view>

    <!-- 刻度进度条 -->
    <view class="scale-container">
      <view class="scale-bar">
        <view class="indicator" style="left: {{indicatorLeft}};"></view>
      </view>
      <view class="scale-labels">
        <block wx:for="{{scaleLabels}}" wx:key="key">
          <text class="{{item.active ? 'active' : ''}}">{{item.label}}</text>
        </block>
      </view>
    </view>

    <!-- v2.0 语义一致性卡片 -->
    <view wx:if="{{analysis.semanticConsistency}}" class="consistency-section">
      <view class="section-title">
        语义连贯性
        <text class="count">
          {{analysis.semanticConsistency.gapCount > 0 || analysis.semanticConsistency.contradictionCount > 0 ? '发现问题' : '良好'}}
        </text>
      </view>
      <view class="consistency-grid">
        <view class="consistency-item {{analysis.semanticConsistency.gapCount > 0 ? 'warn' : ''}}">
          <view class="consistency-label">语义断层</view>
          <view class="consistency-val">{{analysis.semanticConsistency.gapCount}}处</view>
        </view>
        <view class="consistency-item {{analysis.semanticConsistency.contradictionCount > 0 ? 'warn' : ''}}">
          <view class="consistency-label">观点矛盾</view>
          <view class="consistency-val">{{analysis.semanticConsistency.contradictionCount}}处</view>
        </view>
        <view class="consistency-item {{analysis.semanticConsistency.redundancyCount > 0 ? 'warn' : ''}}">
          <view class="consistency-label">论据重复</view>
          <view class="consistency-val">{{analysis.semanticConsistency.redundancyCount}}处</view>
        </view>
      </view>
    </view>

    <!-- AI痕迹分析列表 -->
    <view class="analysis-section {{displayIssues.length ? '' : 'empty'}}">
      <view class="section-title">AI痕迹分析 <text class="count">共{{displayIssues.length}}项</text></view>
      <scroll-view class="analysis-scroll" scroll-y>
        <block wx:if="{{displayIssues.length}}">
          <view wx:for="{{displayIssues}}" wx:key="index" class="issue-item">
            <view class="issue-icon" style="background: {{item.bgColor}}">
              <text class="issue-num">{{index + 1}}</text>
            </view>
            <view class="issue-content">
              <view class="issue-name">{{item.title}}</view>
              <view class="issue-detail">{{item.desc}}</view>
            </view>
            <view class="issue-tag {{item.levelClass}}">{{item.level}}</view>
          </view>
        </block>
        <view wx:else class="empty-issues">
          <text class="empty-issues-icon">✓</text>
          <text class="empty-issues-text">未检测到明显 AI 痕迹特征</text>
        </view>
      </scroll-view>
    </view>

    <!-- 底部操作按钮 -->
    <view class="btn-area">
      <button class="action-btn action-btn-primary" bindtap="goIssues">查看问题句子</button>
      <button class="action-btn action-btn-secondary" bindtap="recheck">重新检测</button>
    </view>

    <!-- 底部 tab 切换 -->
    <tab-bar id="tab-bar"></tab-bar>

    </view>

  <!-- 空状态 -->
  <view wx:else class="empty-state">
    <text class="empty-title">暂无检测结果</text>
    <text class="empty-desc">请先回到首页输入文章。</text>
  </view>

  <view class="bottom-spacer"></view>
</view>
