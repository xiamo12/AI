<view class="page">
  <view class="header">
    <view class="back" bindtap="goBack">‹ 返回</view>
    <text class="title">{{title}}</text>
    <text class="updated">更新日期：{{updatedAt}}</text>
  </view>
  <scroll-view class="body" scroll-y>
    <view wx:for="{{sections}}" wx:key="heading" class="section">
      <text class="heading">{{item.heading}}</text>
      <text class="body-text">{{item.body}}</text>
    </view>
    <view class="bottom-spacer"></view>
  </scroll-view>
</view>
