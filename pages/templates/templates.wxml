<scroll-view class="page" scroll-y type="list">
  <!-- 顶部紫粉渐变 -->
  <view class="top-banner page-banner"></view>

  <!-- 主卡片内容区 -->
  <view class="main-card">
    <view class="template-grid">
      <view wx:for="{{templates}}" wx:key="title" data-scene="{{item.scene}}" bindtap="selectTemplate" class="template-card {{selectedScene === item.scene ? 'active' : ''}}">
        <text class="t-icon">{{item.icon}}</text>
        <text class="t-name">{{item.title}}</text>
        <text class="t-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
  <view class="bottom-spacer"></view>
</scroll-view>
