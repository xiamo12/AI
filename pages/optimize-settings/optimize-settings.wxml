<scroll-view class="safe-page" scroll-y type="list">
  <view class="nav-bar"><button class="nav-icon" bindtap="goBack">‹</button><text class="nav-title">去AI味设置</text><button class="nav-icon" bindtap="goHome">⌂</button></view>
  <view class="setting-section"><view class="section-line"><text class="section-title">优化强度</text><text class="help">如何选择？</text></view>
    <view wx:for="{{intensities}}" wx:key="key" data-key="{{item.key}}" bindtap="selectIntensity" class="card intensity-card {{intensity === item.key ? 'active' : ''}}">
      <view><text class="intensity-title">{{item.name}}</text><text class="intensity-desc">{{item.desc}}</text></view><text class="check">{{intensity === item.key ? '✓' : ''}}</text>
    </view>
  </view>
  <view class="setting-section"><text class="section-title">使用场景</text><text class="section-subtitle">选择场景可获得更贴近语境的优化效果</text>
    <view class="scene-grid"><view wx:for="{{scenes}}" wx:key="name" data-name="{{item.name}}" bindtap="selectScene" class="scene-item {{scene === item.name ? 'active' : ''}}"><text>{{item.icon}}</text><text>{{item.name}}</text></view></view>
  </view>
  <view class="card options-card"><view class="option-row"><text>尽量保留原意</text><switch checked="{{preserveMeaning}}" bindchange="toggleMeaning" color="#13a86d" /></view><view class="option-row"><text>保留原文结构</text><switch checked="{{preserveStructure}}" bindchange="toggleStructure" color="#13a86d" /></view></view>
  <button class="primary-btn amber" loading="{{busy}}" bindtap="startOptimize">开始优化</button>
  <text class="tip">预计需要10-30秒，请耐心等待</text>
</scroll-view>
