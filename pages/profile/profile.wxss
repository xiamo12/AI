.profile-card { margin-top: 22rpx; padding: 28rpx; display: flex; align-items: center; gap: 20rpx; }.avatar { width: 88rpx; height: 88rpx; border-radius: 24rpx; background: linear-gradient(145deg,#075f73,#13a86d); color: #fff; font-size: 30rpx; font-weight: 900; line-height: 88rpx; text-align: center; }.name { display: block; color: #102733; font-size: 31rpx; font-weight: 900; }.desc { display: block; margin-top: 8rpx; color: #7f8b9a; font-size: 23rpx; }.stats { margin-top: 22rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }.stat { padding: 28rpx; text-align: center; }.stat text:first-child { display: block; color: #075f73; font-size: 46rpx; font-weight: 900; }.stat text:last-child { display: block; margin-top: 8rpx; color: #7f8b9a; font-size: 23rpx; }.about { margin-top: 22rpx; padding: 28rpx; }