<scroll-view class="page" scroll-y type="list">
  <!-- 顶部紫粉渐变 -->
  <view class="top-banner page-banner"></view>

  <!-- 主卡片 -->
  <view class="main-card">
    <!-- 用户信息 -->
    <view class="profile-card">
      <view class="avatar">AI</view>
      <view class="profile-info">
        <text class="name">阅检用户</text>
        <text class="desc">本地检测工具，数据仅保存在当前设备</text>
      </view>
    </view>

    <!-- 统计 -->
    <view class="stats-row">
      <view class="stat-item" bindtap="goHistory">
        <text class="stat-num">{{total}}</text>
        <text class="stat-label">历史记录</text>
      </view>
    </view>

    <!-- 使用说明 -->
    <view class="about-section">
      <text class="section-title">使用说明</text>
      <text class="section-desc">检测在您的设备本地完成，正文不会上传服务器。分数为 AI 痕迹参考指数，仅供写作辅助，不构成权威鉴定。</text>
    </view>

    <view class="menu-section">
      <view class="menu-item" data-type="privacy" bindtap="goLegal">
        <text class="menu-label">隐私政策</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" data-type="agreement" bindtap="goLegal">
        <text class="menu-label">用户服务协议</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item menu-danger" bindtap="onClearHistory">
        <text class="menu-label">清空历史记录</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
  <view class="bottom-spacer"></view>
</scroll-view>
