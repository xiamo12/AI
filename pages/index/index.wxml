<scroll-view class="page home-page" scroll-y type="list">
  <view class="home-hero">
    <view class="status-row">
      <text class="time">9:41</text>
      <view class="capsule"><text>•••</text><text class="circle">◎</text></view>
    </view>
    <view class="brand-row">
      <view class="logo">AI</view>
      <view>
        <text class="brand-title">阅检AI助手</text>
        <text class="brand-desc">检测AI痕迹，一键去AI味</text>
      </view>
    </view>
    <view class="hero-art">
      <view class="paper"><view></view><view></view><view></view></view>
      <view class="lens">AI</view>
      <view class="orbit"></view>
    </view>
  </view>

  <view class="home-body">
    <view class="mode-tabs">
      <view wx:for="{{tabs}}" wx:key="*this" data-tab="{{item}}" bindtap="switchTab" class="mode-tab {{activeTab === item ? 'active' : ''}}">{{item}}</view>
    </view>

    <view class="card paste-card">
      <view class="card-head">
        <text class="section-title">粘贴文章内容</text>
        <button class="clear-btn" bindtap="clearText">清空</button>
      </view>
      <textarea class="article-input" value="{{articleText}}" maxlength="{{maxLength}}" bindinput="onInput" placeholder="请粘贴或输入需要检测的文章内容\n建议不少于100字，检测结果更准确哦～" />
      <view class="input-footer">
        <button class="paste-btn" bindtap="pasteText">一键粘贴</button>
        <text>{{articleText.length}}/{{maxLength}}</text>
      </view>
    </view>

    <view class="type-section">
      <view class="section-line">
        <text class="section-title">选择文章类型</text>
        <button class="more-btn" bindtap="useSample">示例文章</button>
      </view>
      <view class="type-grid">
        <view wx:for="{{articleTypes}}" wx:key="name" data-index="{{index}}" bindtap="selectType" class="type-item {{typeIndex === index ? 'active' : ''}}">
          <text class="type-icon">{{item.icon}}</text>
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{activeTab === '去痕改写'}}" class="card reference-card">
      <view class="section-line">
        <view>
          <text class="section-title">参考文章风格</text>
          <text class="section-subtitle">可选。用于学习你的框架、遣词和段落节奏。</text>
        </view>
        <button class="clear-btn" bindtap="clearReference">清空</button>
      </view>
      <textarea class="reference-input" value="{{referenceText}}" maxlength="{{maxLength}}" bindinput="onReferenceInput" placeholder="粘贴一篇你的参考文章，输出会更贴近你的写法。" />
      <view wx:if="{{styleProfile}}" class="style-chip">{{styleProfile.summary}}</view>
    </view>

    <button class="primary-btn {{activeTab === '去痕改写' ? 'amber' : ''}}" loading="{{busy}}" bindtap="runPrimaryAction">
      {{activeTab === 'AI检测' ? (hasDetected ? '重新扫描' : '开始扫描') : '立即去痕'}}
    </button>
    <button class="ghost-btn direct-btn" bindtap="toggleMode">{{activeTab === 'AI检测' ? '直接去AI味' : '返回AI检测'}}</button>
    <view class="notice">检测结果仅供辅助判断，建议结合人工复核。</view>
  </view>
</scroll-view>
