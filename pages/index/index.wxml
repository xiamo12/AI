<view class="page-wrap">
  <scroll-view class="main-scroll" scroll-y type="list">
    <!-- 顶部通栏 -->
    <view class="top-banner">
      <image class="wave-decor" src="/assets/home/wave-bg.png" mode="aspectFill"></image>
      <view class="header-row">
        <view class="title-group">
          <text class="main-title">阅检</text>
          <text class="sub-title">本地 AI 痕迹检测 · 正文不上传</text>
        </view>
      </view>
      <image class="robot-img" src="/assets/home/robot.png" mode="aspectFit"></image>
    </view>

    <!-- 主卡片 -->
    <view class="main-card">
      <view class="input-header">
        <text class="input-title">粘贴文本内容</text>
        <text class="clear-btn" bindtap="clearText">清空</text>
      </view>

      <textarea class="text-input" value="{{articleText}}" maxlength="{{maxLength}}" bindinput="onInput" placeholder="请粘贴需要检测的文本内容&#10;建议不少于100字，检测结果更准确哦～"></textarea>

      <!-- 一键粘贴 + 字数统计 -->
      <view class="paste-row">
        <button class="paste-btn" bindtap="pasteText">一键粘贴</button>
        <text class="word-count">{{articleText.length}}/{{maxLength}}</text>
      </view>

      <view class="template-section">
        <view class="template-header">
          <text class="template-title">选择文本类型</text>
          <text class="more-template" bindtap="goTemplates">写作模板 ></text>
        </view>
        <view class="template-grid">
          <view wx:for="{{articleTypes}}" wx:key="name" data-index="{{index}}" bindtap="selectType" class="template-card {{typeIndex === index ? 'active' : ''}}">
            <text class="t-icon">{{item.icon}}</text>
            <text class="t-name">{{item.nameShort || item.name}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- 固定底部检测按钮 -->
  <view class="bottom-fixed-bar">
    <button class="detect-btn" loading="{{busy}}" bindtap="detectText">
      <text wx:if="{{!busy}}">开始检测</text>
      <text wx:else>检测中…</text>
    </button>
    <text class="detect-desc">本地分析 AI 痕迹，结果仅供参考</text>
  </view>

  <!-- 粘贴前隐私授权（须使用 agreePrivacyAuthorization 按钮同步授权状态） -->
  <view wx:if="{{showPrivacyForPaste}}" class="privacy-mask" catchtouchmove="true">
    <view class="privacy-dialog">
      <text class="privacy-title">使用一键粘贴</text>
      <text class="privacy-desc">需要您同意{{privacyContractName}}。我们仅读取剪贴板内容并填入输入框，不会上传服务器。</text>
      <view class="privacy-actions">
        <button class="privacy-link-btn" bindtap="openPrivacyContract">查看隐私指引</button>
        <button
          id="privacy-agree-btn"
          class="privacy-agree-btn"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="onAgreePrivacyForPaste"
        >同意并粘贴</button>
        <button class="privacy-cancel-btn" bindtap="cancelPrivacyForPaste">取消</button>
      </view>
    </view>
  </view>
</view>
