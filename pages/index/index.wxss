/* 首页 — 阅检AI助手 v2 */
.page {
  background: #F6F7FB;
  min-height: 100vh;
}

/* ===== 顶部通栏 ===== */
.top-banner {
  height: 480rpx;
  border-bottom-left-radius: 28rpx;
  border-bottom-right-radius: 28rpx;
  background: linear-gradient(135deg, #5B5CFF 0%, #8A3CFF 50%, #FF4FCB 100%);
  padding: 136rpx 46rpx 0;
  position: relative;
}
.wave-decor {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 120rpx;
  opacity: 1;
  z-index: 10;
}

/* 头部行 */
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 3;
}
.title-group {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}
.main-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  white-space: nowrap;
}
.sub-title {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255,255,255,0.8);
  white-space: nowrap;
}
.mini-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.icon-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
  border: none;
  padding: 0;
}

/* 首页插图 — 位于 banner 右下，在主卡片上方 */
.robot-img {
  position: absolute;
  left: 100rpx;
  bottom: -110rpx;
  width: 360rpx;
  height: 360rpx;
  z-index: 5;
  transform: scale(3);
}

/* ===== 主卡片 ===== */
.main-card {
  margin: 10rpx 20rpx 0;
  padding: 24rpx 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(39, 52, 125, 0.08);
  position: relative;
  z-index: 10;
}

/* 输入区 */
.input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.input-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
}
.clear-btn {
  font-size: 24rpx;
  color: #999999;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: transparent;
  border: none;
  line-height: 1;
}
.clear-btn:active {
  background: #f0f0f0;
}

/* 文本输入框 */
.text-input {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #333333;
  border: 2rpx solid #EEF0F5;
  outline: none;
  resize: none;
  box-sizing: border-box;
  line-height: 2.2 !important;
}
.text-input::placeholder {
  color: #B7B9C5;
  line-height: 2.2;
}
.text-input:focus {
  border-color: #6D5CFF;
}

/* 字数 + 一键粘贴行 */
.word-count-row {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4rpx;
}
.paste-btn {
  font-size: 24rpx;
  color: #6D5CFF;
  font-weight: 600;
  background: #F5F3FF;
  border: 2rpx solid #E2DEFF;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  line-height: 1.5;
  height: auto;
}
.paste-btn:active {
  background: #EBE8FF;
}
.word-count {
  text-align: right;
  font-size: 22rpx;
  color: #B0B3BE;
}

/* 文本类型 */
.template-section {
  margin-top: 24rpx;
}
.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.template-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222222;
}
.more-template {
  font-size: 24rpx;
  color: #8D8FA3;
  padding: 4rpx 8rpx;
}

/* 4列网格 */
.template-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}
.template-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 100rpx;
  border-radius: 16rpx;
  border: 2rpx solid #EEF0F5;
  background: #FFFFFF;
}
.template-card:active {
  transform: scale(0.96);
}
.template-card.active {
  border: 3rpx solid #6D5CFF;
  background: #F5F3FF;
}
.t-icon {
  font-size: 32rpx;
}
.t-name {
  font-size: 22rpx;
  color: #333333;
  font-weight: 500;
}
.template-card.active .t-name {
  color: #6D5CFF;
  font-weight: 700;
}

/* 检测按钮 */
.detect-btn {
  margin-top: 24rpx;
  height: 100rpx;
  border-radius: 50rpx;
  background: linear-gradient(90deg, #5568FF 0%, #FF47C7 100%);
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  box-shadow: 0 10rpx 20rpx rgba(106, 92, 255, 0.25);
  border: none;
  line-height: 100rpx;
  text-align: center;
}
.detect-btn:active {
  transform: translateY(2rpx);
  opacity: 0.9;
}

/* 按钮下方说明 */
.detect-desc {
  margin-top: 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8D8FA3;
}

/* 底部安全区 */
.bottom-spacer {
  height: 120rpx;
}
