/* 首页 — 阅检AI助手 v2 */

/* ===== 页面布局：上下结构，底部固定 ===== */
.page-wrap {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F6F7FB;
}
.main-scroll {
  flex: 1;
  overflow-y: scroll;
}

/* ===== 顶部通栏 ===== */
.top-banner {
  height: 480rpx;
  border-bottom-left-radius: 28rpx;
  border-bottom-right-radius: 28rpx;
  background: linear-gradient(135deg, #5B5CFF 0%, #8A3CFF 50%, #FF4FCB 100%);
  padding: 136rpx 46rpx 0;
  position: relative;
}
.wave-decor {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 120rpx;
  opacity: 1;
  z-index: 10;
}

/* 头部行 */
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 3;
}
.title-group {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

/* 阅检 — 大师感字体设计 */
.main-title {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 16rpx;
  color: #FFFFFF;
}
.sub-title {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(255,255,255,0.8);
  white-space: nowrap;
}
.mini-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.icon-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
  border: none;
  padding: 0;
}

/* 首页插图 — 位于 banner 右下，在主卡片上方 */
.robot-img {
  position: absolute;
  left: 100rpx;
  bottom: -110rpx;
  width: 360rpx;
  height: 360rpx;
  z-index: 5;
  transform: scale(3);
}

/* ===== 主卡片 ===== */
.main-card {
  margin: -10rpx 20rpx 0;
  padding: 24rpx 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(39, 52, 125, 0.08);
  position: relative;
  z-index: 10;
}

/* 输入区 */
.input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.input-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
  padding: 12rpx 0 12rpx 14rpx;
  border-left: 4rpx solid #6D5CFF;
  line-height: 1.5;
}
.clear-btn {
  font-size: 22rpx;
  color: #8D8FA3;
  font-weight: 500;
  background: #F5F6FB;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  line-height: 1;
}
.clear-btn:active {
  background: #EBECF3;
}

/* 文本输入框 */
.text-input {
  width: 100%;
  height: 340rpx;
  padding: 24rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #333333;
  border: 2rpx solid #EEF0F5;
  outline: none;
  resize: none;
  box-sizing: border-box;
  line-height: 2.2 !important;
}
.text-input::placeholder {
  color: #B7B9C5;
  line-height: 2.2;
}
.text-input:focus {
  border-color: #6D5CFF;
}

/* 一键粘贴 + 字数统计 — 同一行 */
.paste-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.paste-btn {
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: 36rpx;
  background: linear-gradient(90deg, #6D5CFF 0%, #9B7AFF 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(109, 92, 255, 0.2);
  line-height: 72rpx;
  text-align: center;
}
.paste-btn:active {
  opacity: 0.9;
  transform: translateY(2rpx);
}

.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.privacy-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
}

.privacy-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.privacy-desc {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5a5d70;
}

.privacy-actions {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.privacy-link-btn,
.privacy-agree-btn,
.privacy-cancel-btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.privacy-link-btn {
  background: #f0f2f8;
  color: #6d5cff;
}

.privacy-agree-btn {
  background: linear-gradient(90deg, #6d5cff 0%, #9b7aff 100%);
  color: #fff;
}

.privacy-cancel-btn {
  background: #fff;
  color: #8d8fa3;
  border: 2rpx solid #eef0f5;
}

/* 字数 */
.word-count {
  font-size: 22rpx;
  color: #B0B3BE;
}

/* 文本类型 */
.template-section {
  margin-top: 15rpx;
}
.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.template-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
  padding: 12rpx 0 12rpx 14rpx;
  border-left: 4rpx solid #6D5CFF;
  line-height: 1.5;
}
.more-template {
  font-size: 22rpx;
  color: #6D5CFF;
  font-weight: 600;
  background: #F0EEFF;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  line-height: 1;
}
.more-template:active {
  background: #E2DEFF;
}

/* 3列网格（6个类型分两行） */
.template-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}
.template-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 100rpx;
  border-radius: 16rpx;
  border: 2rpx solid #EEF0F5;
  background: #FFFFFF;
}
.template-card:active {
  transform: scale(0.96);
}
.template-card.active {
  border: 3rpx solid #6D5CFF;
  background: #F5F3FF;
}
.t-icon {
  font-size: 32rpx;
}
.t-name {
  font-size: 22rpx;
  color: #333333;
  font-weight: 500;
}
.template-card.active .t-name {
  color: #6D5CFF;
  font-weight: 700;
}

/* ===== 固定底部检测按钮 ===== */
.bottom-fixed-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #F6F7FB;
  padding: 0 32rpx calc(60rpx + env(safe-area-inset-bottom));
}

.detect-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  background: linear-gradient(90deg, #5568FF 0%, #FF47C7 100%);
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  box-shadow: 0 10rpx 20rpx rgba(106, 92, 255, 0.25);
  border: none;
  line-height: 100rpx;
  text-align: center;
}
.detect-btn:active {
  transform: translateY(2rpx);
  opacity: 0.9;
}

.detect-desc {
  margin-top: 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8D8FA3;
}

/* 底部安全区（防止滚动内容被固定栏遮挡） */
.bottom-spacer {
  height: 260rpx;
}
