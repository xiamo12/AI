/* ===== 页面布局：全屏固定，顶部/底部固定，中间滚动 ===== */
.page-wrap {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F6F7FB;
  overflow: hidden;
}

/* ===== 顶部渐变头（固定位置） ===== */
.top-banner {
  flex-shrink: 0;
  height: 256rpx;
  background: linear-gradient(135deg, #5B5CFF 0%, #8A3CFF 50%, #FF4FCB 100%);
  position: relative;
  border-radius: 0 0 50rpx 50rpx;
  overflow: hidden;
}

/* 一键清空 — 半透明白色胶囊按钮 */
.clear-action {
  position: absolute;
  bottom: 28rpx;
  left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #6D5CFF;
  font-weight: 800;
  width: 184rpx;
  padding: 26rpx 0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.7);
  border: none;
  line-height: 1;
  z-index: 5;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.clear-action:active {
  background: rgba(255, 255, 255, 0.5);
  transform: scale(0.96);
}

/* ===== 记录列表（可滚动区域） ===== */
.list-scroll {
  flex: 1;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
}

/* ===== 主卡片区（同首页） ===== */
.main-card {
  margin: 10rpx 20rpx 0;
  padding: 24rpx 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(39, 52, 125, 0.08);
  position: relative;
  z-index: 10;
}

/* ===== 记录卡片 ===== */
.record-card {
  padding: 22rpx 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 2rpx solid #F0F2F8;
}
.record-card:last-child {
  border-bottom: none;
}

.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #F0EEFF;
  color: #6D5CFF;
  font-size: 34rpx;
  line-height: 72rpx;
  text-align: center;
  flex-shrink: 0;
}
.record-info {
  flex: 1;
  min-width: 0;
}
.record-title {
  display: block;
  color: #222222;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.record-meta {
  display: block;
  margin-top: 8rpx;
  color: #8D8FA3;
  font-size: 22rpx;
}
.record-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}
.record-meta-row .tag-type {
  font-size: 20rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #E8F4FD;
  color: #3B82F6;
  font-weight: 600;
  flex-shrink: 0;
}
.record-meta-row .record-meta {
  margin-top: 0;
  font-size: 22rpx;
  color: #8D8FA3;
}
.record-tags {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}
.tag-status, .tag-score, .tag-type {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 40rpx;
}
.tag-status.status-detect {
  background: #F0EEFF;
  color: #6D5CFF;
}
.tag-score {
  background: #F5F6FB;
  color: #555770;
}
.tag-type {
  background: #E8F4FD;
  color: #3B82F6;
}

/* ===== 空状态 ===== */
.empty-block {
  padding: 80rpx 0;
  text-align: center;
}
.empty-title {
  display: block;
  color: #222222;
  font-size: 30rpx;
  font-weight: 600;
}
.empty-desc {
  display: block;
  margin-top: 14rpx;
  color: #8D8FA3;
  font-size: 24rpx;
}

/* ===== 底部安全区（防止tab-bar遮挡最后一条记录） ===== */
.scroll-bottom-spacer {
  height: 180rpx;
}
