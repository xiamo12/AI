.container {
  background: #F4F7FF;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  padding: 240rpx 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #E0E4EA;
  border-top-color: #6A5AE0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  margin-top: 20rpx;
  color: #8D8FA3;
  font-size: 26rpx;
}

/* ===== 返回按钮（同 result 页） ===== */
.back-btn {
  position: fixed;
  left: 16rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
  z-index: 50;
}
.back-btn:active {
  background: rgba(255, 255, 255, 0.35);
}

/* ===== 顶部紫粉渐变背景 ===== */
.header-bg {
  height: 320rpx;
  background: linear-gradient(135deg, #6A5AE0 0%, #D83AB3 100%);
  position: relative;
  border-radius: 0 0 50rpx 50rpx;
  overflow: hidden;
}
.robot-icon {
  position: absolute;
  left: 50%;
  top: 40rpx;
  width: 240rpx;
  height: 240rpx;
  margin-left: -120rpx;
  transform: scale(2.8);
  transform-origin: center center;
  opacity: 0.3;
}
.header-title-area {
  position: absolute;
  bottom: 44rpx;
  left: 0;
  right: 0;
  text-align: center;
}
.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
}
.header-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

/* ===== 过滤标签 ===== */
.filter-tabs {
  padding: 24rpx 32rpx 0;
  display: flex;
  gap: 16rpx;
  background: #F4F7FF;
}
.filter-tab {
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  color: #8D8FA3;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 60rpx;
  border: 2rpx solid #E0E4EA;
  flex-shrink: 0;
}
.filter-tab:active {
  opacity: 0.85;
}
.filter-tab.active {
  background: linear-gradient(90deg, #6A5AE0, #D83AB3);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(106, 90, 224, 0.25);
}

/* ===== 问题卡片列表 ===== */
.issue-scroll {
  flex: 1;
  padding: 24rpx 32rpx 0;
  overflow-y: scroll;
}

.issue-card {
  background: #FFFFFF;
  border-radius: 30rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(106, 90, 224, 0.06);
}
.issue-card:last-child {
  margin-bottom: 0;
}

.issue-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.issue-badge {
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 42rpx;
  flex-shrink: 0;
}
.issue-badge.high {
  background: #FFF0ED;
  color: #EF4444;
}
.issue-badge.medium {
  background: #FFFBEB;
  color: #F59E0B;
}
.issue-badge.low {
  background: #F0FDF4;
  color: #22C55E;
}

.issue-score {
  color: #9CA0B4;
  font-size: 24rpx;
}

.issue-text {
  display: block;
  margin-top: 28rpx;
  color: #1A1C3D;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
}

.issue-field {
  margin-top: 18rpx;
  color: #555770;
  font-size: 24rpx;
  line-height: 1.55;
}
.field-label {
  color: #6A5AE0;
  font-weight: 700;
}

/* ===== 空状态 ===== */
.empty-card {
  padding: 80rpx 30rpx;
  text-align: center;
  background: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(106, 90, 224, 0.06);
}
.empty-title {
  display: block;
  color: #1A1C3D;
  font-size: 30rpx;
  font-weight: 700;
}
.empty-desc {
  display: block;
  margin-top: 14rpx;
  color: #9CA0B4;
  font-size: 24rpx;
}

/* ===== 底部安全区 ===== */
.bottom-spacer {
  height: calc(160rpx + env(safe-area-inset-bottom));
}
