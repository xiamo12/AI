<view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 主要内容 -->
  <block wx:else>
    <!-- 返回按钮（与 result 页同款） -->
    <view class="back-btn" style="top: calc({{statusBarHeight}}px + 12px);" bindtap="goBack">‹</view>

    <!-- 顶部背景（紫粉渐变 + 机器人） -->
    <view class="header-bg">
      <image class="robot-icon" src="/assets/home/robot.png" mode="widthFix" />
      <view class="header-title-area">
        <text class="header-title">问题句子详情</text>
        <text class="header-subtitle">共 {{issues.length}} 个问题句子</text>
      </view>
    </view>

    <!-- 过滤标签 -->
    <view class="filter-tabs">
      <view wx:for="{{filters}}" wx:key="key" data-key="{{item.key}}" bindtap="changeFilter" class="filter-tab {{filter === item.key ? 'active' : ''}}">{{item.name}}({{item.count}})</view>
    </view>

    <!-- 问题列表滚动区 -->
    <scroll-view class="issue-scroll" scroll-y>
      <view wx:if="{{filteredIssues.length}}">
        <view wx:for="{{filteredIssues}}" wx:key="id" class="issue-card">
          <view class="issue-head">
            <text class="issue-badge {{item.riskClass}}">{{item.risk}}</text>
            <text class="issue-score">{{item.type === 'consistency' ? '评分' : '相似度'}} {{item.score}}%</text>
          </view>
          <text wx:if="{{item.text}}" class="issue-text">{{item.text}}</text>
          <view wx:if="{{item.type === 'consistency'}}" class="issue-type-badge">{{item.labels[0]}}</view>
          <view class="issue-field">
            <text class="field-label">问题：</text>
            <text>{{item.problem}}</text>
          </view>
          <view wx:if="{{item.suggestion}}" class="issue-field">
            <text class="field-label">建议：</text>
            <text>{{item.suggestion}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty-card">
        <text class="empty-title">暂无此类问题</text>
        <text class="empty-desc">当前文章没有明显命中该风险等级。</text>
      </view>
      <view class="bottom-spacer"></view>
    </scroll-view>
  </block>

  <!-- 底部 tab 切换 -->
  <tab-bar id="tab-bar"></tab-bar>
</view>
