<scroll-view class="safe-page" scroll-y type="list">
  <view class="nav-bar"><button class="nav-icon" bindtap="goBack">‹</button><text class="nav-title">问题句子详情</text><button class="nav-icon" bindtap="goHome">⌂</button></view>
  <view class="filter-tabs">
    <view wx:for="{{filters}}" wx:key="key" data-key="{{item.key}}" bindtap="changeFilter" class="filter-tab {{filter === item.key ? 'active' : ''}}">{{item.name}}({{item.count}})</view>
  </view>
  <view wx:if="{{filteredIssues.length}}">
    <view wx:for="{{filteredIssues}}" wx:key="id" class="card issue-card">
      <view class="issue-head"><text class="badge {{item.riskClass}}">{{item.risk}}</text><text class="similar">相似度 {{item.score}}%</text></view>
      <text class="issue-text">{{item.text}}</text>
      <view class="issue-line"><text>问题：</text>{{item.problem}}</view>
      <view class="issue-line"><text>建议：</text>{{item.suggestion}}</view>
      <view class="example-box"><text class="example-title">优化示例：</text><text>{{item.example}}</text></view>
    </view>
  </view>
  <view wx:else class="card empty-state"><text class="empty-title">暂无此类问题</text><text class="empty-desc">当前文章没有明显命中该风险等级。</text></view>
</scroll-view>
