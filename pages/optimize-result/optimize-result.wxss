.done-card { margin-top: 14rpx; padding: 34rpx; border-radius: 22rpx; background: radial-gradient(circle at 80% 20%, rgba(19,168,109,.34), transparent 42%), linear-gradient(135deg, #074c67, #053742); color: #fff; text-align: center; }
.done-title { display: block; font-size: 34rpx; font-weight: 900; }
.compare-row { margin-top: 28rpx; display: flex; align-items: center; justify-content: center; gap: 26rpx; }
.score-box { width: 160rpx; height: 150rpx; border-radius: 16rpx; background: rgba(255,255,255,.12); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.score-box text:first-child { font-size: 23rpx; opacity: .82; }
.score-box text:last-child { margin-top: 12rpx; font-size: 52rpx; font-weight: 900; }
.score-box.before text:last-child { color: #ff6b5f; } .score-box.after { background: #eafff7; color: #075f73; } .score-box.after text:last-child { color: #08775f; }
.arrow { font-size: 54rpx; font-weight: 900; }
.down { display: block; margin-top: 22rpx; font-size: 30rpx; font-weight: 800; }
.continue-tip { display: block; margin-top: 12rpx; color: rgba(255,255,255,.78); font-size: 23rpx; }
.tabs { margin-top: 28rpx; display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1rpx solid #e5ecf2; }
.tab { height: 74rpx; color: #6d7b8e; font-size: 27rpx; font-weight: 700; line-height: 74rpx; text-align: center; }
.tab.active { color: #075f73; border-bottom: 4rpx solid #13a86d; }

.diff-card { margin-top: 22rpx; padding: 24rpx; }
.diff-block { padding: 22rpx 0; border-bottom: 1rpx solid #edf1f5; }
.diff-block:last-child { border-bottom: 0; }
.diff-index { display: block; margin-bottom: 14rpx; color: #758698; font-size: 23rpx; font-weight: 800; }
.diff-fragment { margin-top: 16rpx; }
.diff-fragment:first-of-type { margin-top: 0; }
.diff-before, .diff-after { display: block; font-size: 27rpx; line-height: 1.72; white-space: pre-wrap; }
.diff-before { color: #e4483f; text-decoration: line-through; text-decoration-thickness: 2rpx; }
.diff-after { margin-top: 14rpx; padding: 18rpx; border-radius: 14rpx; background: #effbf4; color: #08775f; font-weight: 700; }
.diff-same { display: block; padding: 12rpx 0; color: #5f6f80; font-size: 26rpx; line-height: 1.68; white-space: pre-wrap; }
.diff-legend { margin-top: 18rpx; display: flex; justify-content: space-between; gap: 18rpx; font-size: 22rpx; }
.legend-before { color: #e4483f; }
.legend-after { color: #08775f; }
.bottom-actions .ghost-btn.hot { border-color: #13a86d; color: #075f73; background: #effbf4; }

.content-card { margin-top: 22rpx; padding: 28rpx; background: linear-gradient(180deg, #f3fbf8, #ffffff); }
.content-text { display: block; color: #102733; font-size: 28rpx; line-height: 1.78; white-space: pre-wrap; }
.content-meta { margin-top: 24rpx; display: flex; align-items: center; justify-content: space-between; color: #758698; font-size: 24rpx; }
.content-meta button { width: 52rpx; height: 52rpx; border-radius: 14rpx; background: #eef8fb; color: #075f73; font-size: 22rpx; line-height: 52rpx; }
.quality-card { margin-top: 22rpx; padding: 24rpx; }
.quality-row { margin-top: 20rpx; display: flex; justify-content: space-between; gap: 20rpx; }
.quality-label { display: block; color: #102733; font-size: 26rpx; font-weight: 800; }
.quality-detail { display: block; margin-top: 6rpx; color: #758698; font-size: 23rpx; line-height: 1.4; }
.quality-status { color: #13a86d; font-size: 24rpx; font-weight: 800; }
.bottom-actions { margin-top: 24rpx; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.bottom-actions .ghost-btn { height: 78rpx; font-size: 24rpx; line-height: 78rpx; }
