page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f9fb;
  color: #102733;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

view, text, textarea, button, input, scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  background: #f7f9fb;
}

