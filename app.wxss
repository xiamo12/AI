page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f7f9fb;
  color: #102733;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

view, text, textarea, button, input, scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  background: #f7f9fb;
}

.safe-page {
  min-height: 100vh;
  padding: calc(24rpx + env(safe-area-inset-top)) 24rpx calc(170rpx + env(safe-area-inset-bottom));
  background: #f7f9fb;
}

.nav-bar {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  color: #0f1f2b;
  font-size: 33rpx;
  font-weight: 800;
}

.nav-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  color: #172536;
  font-size: 42rpx;
  line-height: 88rpx;
  text-align: center;
}

.nav-icon.small {
  width: 56rpx;
  height: 56rpx;
  font-size: 30rpx;
  line-height: 56rpx;
}

.nav-actions {
  width: 128rpx;
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
}

.card {
  border: 1rpx solid #e7edf3;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(24, 38, 60, 0.06);
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #074c67 0%, #0a7c89 52%, #13a86d 100%);
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 18rpx 34rpx rgba(7, 95, 115, 0.24);
}

.ghost-btn {
  height: 84rpx;
  border: 1rpx solid #c8d4e0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #174357;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 84rpx;
  text-align: center;
}

.section-title {
  color: #102733;
  font-size: 31rpx;
  font-weight: 800;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #7b8795;
  font-size: 24rpx;
  line-height: 1.45;
}

.empty-state {
  margin-top: 32rpx;
  padding: 80rpx 30rpx;
  text-align: center;
}

.empty-title {
  display: block;
  color: #102733;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-desc {
  display: block;
  margin-top: 14rpx;
  color: #8a96a5;
  font-size: 25rpx;
}

.risk-high { color: #ef4444; }
.risk-medium { color: #f59e0b; }
.risk-low { color: #10a66b; }
