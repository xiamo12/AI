.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  height: 100rpx;
  padding: 6rpx 0 calc(6rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(18rpx);
  border-top: 1rpx solid rgba(200, 195, 240, 0.3);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.tab-item {
  min-width: 0;
  border-radius: 22rpx;
  color: #7a8797;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  line-height: 42rpx;
  text-align: center;
}

.tab-item.active {
  color: #6D5CFF;
  background: linear-gradient(180deg, #F0EEFF 0%, #FFFFFF 100%);
}

.tab-item.active .tab-icon {
  background: linear-gradient(145deg, #6D5CFF, #D83AB3);
  color: #ffffff;
  box-shadow: 0 10rpx 18rpx rgba(109, 92, 255, 0.25);
}
