.tab-shell {
  position: fixed;
  left: 22rpx;
  right: 22rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 99;
  height: 112rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid rgba(225, 235, 242, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 52rpx rgba(24, 38, 60, 0.14);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  backdrop-filter: blur(18rpx);
}

.tab-item {
  min-width: 0;
  border-radius: 22rpx;
  color: #7a8797;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  line-height: 42rpx;
  text-align: center;
}

.tab-item.active {
  color: #075f73;
  background: linear-gradient(180deg, #eaf8f7 0%, #ffffff 100%);
}

.tab-item.active .tab-icon {
  background: linear-gradient(145deg, #075f73, #13a86d);
  color: #ffffff;
  box-shadow: 0 10rpx 18rpx rgba(7, 95, 115, 0.22);
}
