{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "dist-core",
    "rootDir": ".",
    "allowJs": false,
    "noEmit": false,
    "sourceMap": false
  },
  "include": [
    "core/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-core",
    "core/**/__tests__"
  ]
}
